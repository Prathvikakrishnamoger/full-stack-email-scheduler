# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/email-scheduler

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_in_production

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# BullMQ Worker
WORKER_CONCURRENCY=5

# Rate Limiting
MAX_EMAILS_PER_HOUR=500
MAX_EMAILS_PER_HOUR_PER_SENDER=100
MIN_DELAY_BETWEEN_SENDS_MS=2000

# Ethereal SMTP Sender Accounts (JSON array)
# If empty, the app auto-creates one Ethereal account on startup
# Format: [{"email":"user@ethereal.email","pass":"password"}]
SENDER_ACCOUNTS=
